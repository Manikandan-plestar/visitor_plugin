# ==============================================================================
# Central Visitor Intelligence Backend - Production Environment Variables
# ==============================================================================

# Server Port (default 4000 or set by cloud host like Railway/Render/Heroku)
PORT=4000

# Database Configuration (MySQL on your live server)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_db_password
DB_NAME=wordpress_practice

# Internal Staff Security Token (used for staff admin portal)
STAFF_SECRET_KEY=svt_secret_staff_key_2026

# Node Environment
NODE_ENV=production

